# Timezone
TIMEZONE=Asia/Tehran

# Frigate RTSP Re-stream Password
FRIGATE_RTSP_PASSWORD=your_strong_rtsp_password_here

# Storage Mount Path
STORAGE_PATH=/data/nvr

# Camera 1 Credentials & Host
CAM1_HOST=192.168.1.100
CAM1_USER=admin
CAM1_PASS=your_camera_password
CAM1_MAINSTREAM_PATH=/avstream/channel=1/stream=0-mainstream.sdp
CAM1_SUBSTREAM_PATH=/avstream/channel=1/stream=1-substream.sdp

# Camera 2 Credentials & Host
CAM2_HOST=192.168.1.101
CAM2_USER=admin
CAM2_PASS=your_camera_password
CAM2_MAINSTREAM_PATH=/avstream/channel=1/stream=0-mainstream.sdp
CAM2_SUBSTREAM_PATH=/avstream/channel=1/stream=1-substream.sdp

# Optional Notification Email
NOTIFICATION_EMAIL=alerts@example.com
